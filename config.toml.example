# Example configuration for smelly-connect-cli

[vpn]
server = "vpn1.sit.edu.cn"
# Optional private/campus CA file for the VPN server certificate.
# Accepts either a PEM bundle or a single DER certificate.
# ca_cert = "/etc/smelly-connect/campus-root.pem"
# Explicitly bypass server certificate validation for both control-plane HTTPS
# and legacy TLS bootstrap/tunnel flows. Defaults to false.
# When set to true, this overrides ca_cert and skips hostname/trust checks.
insecure_skip_verify = false
# Explicitly disable all session/pool ICMP probing when false.
enable_icmp_keepalive = true
# Optional session-level keepalive target used by the CLI pool/service layer.
# If unset, ICMP probing stays disabled instead of falling back to vpn.server.
default_keepalive_host = "jwxt.sit.edu.cn"

[pool]
# Number of accounts to connect immediately during startup.
prewarm = 2
# Legacy fallback timeout. Used only when the split timeout fields below are absent.
connect_timeout_secs = 20
# Timeout for establishing or recovering one VPN session.
session_connect_timeout_secs = 7
# Probe interval used for pool health checks.
healthcheck_interval_secs = 60
# Current implementation supports round_robin only.
selection = "round_robin"
# Exponential backoff start for failed nodes.
backoff_base_secs = 30
# Exponential backoff cap.
backoff_max_secs = 600

[proxy]
# Timeout for TCP connect from the proxy to the upstream target.
upstream_tcp_connect_timeout_secs = 3

[[accounts]]
name = "acct-01"
username = "user1"
password = "pass1"

[[accounts]]
name = "acct-02"
username = "user2"
password = "pass2"

[proxy.http]
enabled = true
listen = "127.0.0.1:8080"

[proxy.socks5]
enabled = true
listen = "127.0.0.1:1080"
# Optional idle timeout for SOCKS5 UDP ASSOCIATE. 0 or unset disables it.
udp_associate_idle_timeout_secs = 90

[routing]
# Bypass route filtering and allow all destinations through the VPN.
allow_all = false
# Unmatched targets use the local network by default. Set to "block" to restore reject-on-miss.
default_action = "direct"

[[routing.domain_rules]]
domain = "*.foo.edu.cn"
port_min = 443
port_max = 443
protocol = "tcp"

[[routing.ip_rules]]
ip_min = "42.62.107.1"
ip_max = "42.62.107.254"
port_min = 1
port_max = 65535
protocol = "all"

[management]
# Optional local management/status API.
enabled = false
listen = "127.0.0.1:9090"

[logging]
# stdout | file | stdout+file | off
mode = "stdout"
# error | warn | info | debug
level = "info"
file = "smelly-connect.log"
